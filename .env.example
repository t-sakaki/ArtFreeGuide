# Copy to .env.local and fill in. Never commit real values.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=your_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server only: bypasses row level security. Set as a Worker secret in production.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# /admin/readings (the reading correction queue). Magic link sign-in: only these
# addresses may moderate. Comma separated.
ADMIN_EMAILS=you@example.com
# Optional scripting fallback for /api/admin/readings (?token= or {"token"}).
# Set as a Worker secret in production. With neither set the endpoint is closed.
# ADMIN_TOKEN=your_admin_token

# LLM provider: "workers-ai" (default, no key needed), "nvidia" or "gemini"
# LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=your_nvidia_nim_api_key
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-4-hydrogen

# Embedding provider: "nvidia" (default in wrangler.jsonc, uses the embedding_nv
# columns) or "workers-ai" (bge-m3, uses the original embedding columns).
# EMBEDDING_PROVIDER=nvidia
# NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
# Cosine floor for recommendations. Defaults: 0.25 (nvidia) / 0.5 (workers-ai).
# EMBEDDING_MATCH_THRESHOLD=0.25

# Per-task overrides. Falls back to LLM_PROVIDER and each provider's defaults.
# Models are a comma separated priority list (fallback chain).
#   guide   = /api/chat（解説生成・長文JSON）
#   ask     = /api/ask（質問への回答・短文）
#   suggest = /api/suggest（検索サジェスト）
# LLM_GUIDE_PROVIDER=nvidia
# LLM_GUIDE_MODEL=nvidia/nemotron-3-super-120b-a12b,google/gemma-4-31b-it
# LLM_ASK_MODEL=nvidia/nemotron-3-nano-30b-a3b,meta/llama-3.1-70b-instruct
# LLM_SUGGEST_MODEL=mistralai/mistral-nemotron
# Provider level defaults when no task model is set:
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# 画像を読むモデル（/api/identify=写真から作品を特定、見どころのマーク配置）。
# まず Workers AI（キー不要、Cloudflare 上で実行）、失敗時のみ NVIDIA NIM。
# WORKERS_AI_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
# VISION_MODEL は NIM フォールバックの優先順。ローカルスクリプトでは NVIDIA_API_KEY が必要。
# VISION_MODEL=google/gemma-4-31b-it,meta/llama-3.2-11b-vision-instruct
# WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Optional override for the system prompt used in /api/chat. This is the
# deploy-time default; an admin can override it at runtime without a deploy
# via /api/admin/settings (see scripts/mcp_admin_server.mjs).
# GUIDE_SYSTEM_PROMPT=

# MiniMax Week (GMI Cloud) hackathon: per-artwork theme-song generation.
# Lyrics are reasoned by MiniMax M3 via OpenRouter; music is composed by
# MiniMax Music 3.0 via GMI Cloud. Both keys are required for the feature.
# OPENROUTER_API_KEY=your_openrouter_key
# GMI_API_KEY=your_gmi_cloud_key
# GMI_CLOUD_API_KEY=your_gmi_cloud_key  (alias of GMI_API_KEY)

# LINE Bot webhook (/api/line/webhook): AI curator over LINE chat.
# LINE_CHANNEL_SECRET=your_line_channel_secret
# LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
# Public origin used to build the Flex Message "listen now" link and the
# audio message URL LINE fetches back. Defaults to the deployed Worker.
# APP_BASE_URL=https://your-deployment.workers.dev

# TTS for the LINE audio message (/api/tts). LINE's in-app browser blocks the
# Web Speech API, so narration read over LINE chat is synthesized server-side
# instead. Without these, /api/tts serves a silent placeholder MP3 so the bot
# still replies (falls back to text + a link to the web app).
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Neo4j AuraDB / Knowledge Graph (Cloudflare Workers Query API v2 over HTTPS).
# Optional: when unset or unreachable, the app falls back to src/lib/graph/artGraph.data.json.
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_neo4j_password
# NEO4J_DATABASE=neo4j
# Optional explicit endpoint override (defaults to https://<host>/db/<database>/query/v2)
# NEO4J_QUERY_URL=https://xxxxxxxx.databases.neo4j.io/db/neo4j/query/v2
