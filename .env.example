# Copy to .env.local and fill in. Never commit real values.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=your_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server only: bypasses row level security. Set as a Worker secret in production.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# LLM provider: "workers-ai" (default, no key needed), "nvidia" or "gemini"
# LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=your_nvidia_nim_api_key
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key

# Embedding provider: "nvidia" (default in wrangler.jsonc, uses the embedding_nv
# columns) or "workers-ai" (bge-m3, uses the original embedding columns).
# EMBEDDING_PROVIDER=nvidia
# NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
# Cosine floor for recommendations. Defaults: 0.25 (nvidia) / 0.5 (workers-ai).
# EMBEDDING_MATCH_THRESHOLD=0.25

# Per-task overrides. Falls back to LLM_PROVIDER and each provider's defaults.
# Models are a comma separated priority list (fallback chain).
#   guide   = /api/chat（解説生成・長文JSON）
#   ask     = /api/ask（質問への回答・短文）
#   suggest = /api/suggest（検索サジェスト）
# LLM_GUIDE_PROVIDER=nvidia
# LLM_GUIDE_MODEL=nvidia/nemotron-3-super-120b-a12b,google/gemma-4-31b-it
# LLM_ASK_MODEL=nvidia/nemotron-3-nano-30b-a3b,meta/llama-3.1-70b-instruct
# LLM_SUGGEST_MODEL=mistralai/mistral-nemotron
# Provider level defaults when no task model is set:
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# GEMINI_MODEL=gemini-2.5-flash
