{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "art-free-guide",
	"compatibility_date": "2026-07-18",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"vars": {
		// Set to "gemini" to use the Gemini API instead; that needs a GEMINI_API_KEY secret
		// (`wrangler secret put GEMINI_API_KEY`, or .dev.vars / .env.local locally).
		"LLM_PROVIDER": "workers-ai"
	},
	"ai": {
		// Workers AI: inference runs on Cloudflare, no API key needed
		// see https://developers.cloudflare.com/workers-ai/
		"binding": "AI"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "art-free-guide"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}