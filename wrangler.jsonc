{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "art-free-guide",
	"compatibility_date": "2026-07-18",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"vars": {
		// "nvidia" (NVIDIA NIM, needs an NVIDIA_API_KEY secret), "workers-ai"
		// (Cloudflare, no key but only 10,000 free neurons/day) or "gemini"
		// (needs GEMINI_API_KEY). Set secrets with `wrangler secret put <NAME>`,
		// or .dev.vars / .env.local locally.
		"LLM_PROVIDER": "workers-ai,nvidia",
		// Per-task overrides: LLM_<GUIDE|ASK|SUGGEST>_PROVIDER / _MODEL.
		// Models are a comma separated priority list (fallback chain).
		// Guides tolerate ~45s; answers and search chips must feel instant.
		"LLM_GUIDE_PROVIDER": "gemini,workers-ai",
		"GEMINI_MODEL": "gemini-4-hydrogen",
		"LLM_GUIDE_MODEL": "nvidia/nemotron-3-super-120b-a12b,google/gemma-4-31b-it",
		"LLM_ASK_MODEL": "nvidia/nemotron-3-nano-30b-a3b",
		"LLM_SUGGEST_MODEL": "mistralai/mistral-nemotron,meta/llama-3.1-8b-instruct",
		// Embedding space: "nvidia" (embedding_nv column, nvidia/llama-nemotron-embed-vl-1b-v2)
		// or "workers-ai" (embedding column, @cf/baai/bge-m3). Switching back is a
		// one-word change: both column sets are kept populated side by side.
		"EMBEDDING_PROVIDER": "workers-ai",
		// Where generated guides are archived: "d1" | "supabase" | "memory"
		"GUIDE_STORE": "d1",
		// Optional override for the system prompt used in /api/chat
		"GUIDE_SYSTEM_PROMPT": ""
	},
	"d1_databases": [
		{
			// Guide archive, reusing the database the earlier D1 version filled.
			// This is the STAGING database (name predates the staging/main split).
			// npx wrangler d1 migrations apply artfreeguide_db_trial --remote --env staging
			"binding": "DB",
			"database_name": "artfreeguide_db_trial",
			"database_id": "1028e2d0-e5d5-47e7-b828-bacea0c934d0",
			"migrations_dir": "d1/migrations"
		}
	],
	"r2_buckets": [
		{
			// Generated theme-song MP3s (MiniMax Week feature). Private bucket,
			// served through /api/theme-song/audio.
			"binding": "AUDIO",
			"bucket_name": "artfreeguide-audio"
		}
	],
	"ai": {
		// Workers AI: inference runs on Cloudflare, no API key needed
		// see https://developers.cloudflare.com/workers-ai/
		"binding": "AI"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "art-free-guide"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// ── Environments ──────────────────────────────────────────────
	// staging  = pre-production test (art-free-guide-staging.*.workers.dev)
	// production = live (main branch, art-free-guide.*.workers.dev)
	// NOTE: wrangler does NOT inherit top-level vars/d1/ai/images into env.*,
	// so every binding must be repeated under each environment.
	"env": {
		"staging": {
			"name": "art-free-guide-staging",
			"vars": {
				"LLM_PROVIDER": "workers-ai,nvidia",
				"LLM_GUIDE_PROVIDER": "gemini,workers-ai",
				"GEMINI_MODEL": "gemini-4-hydrogen",
				"WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/meta/llama-3.1-8b-instruct-fast",
				"LLM_GUIDE_MODEL": "nvidia/nemotron-3-super-120b-a12b,google/gemma-4-31b-it",
				"LLM_ASK_MODEL": "nvidia/nemotron-3-nano-30b-a3b",
				"LLM_SUGGEST_MODEL": "mistralai/mistral-nemotron,meta/llama-3.1-8b-instruct",
				"EMBEDDING_PROVIDER": "workers-ai",
				"GUIDE_STORE": "d1",
				"GUIDE_SYSTEM_PROMPT": ""
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "artfreeguide_db_trial",
					"database_id": "1028e2d0-e5d5-47e7-b828-bacea0c934d0",
					"migrations_dir": "d1/migrations"
				}
			],
			"ai": { "binding": "AI" },
			"images": { "binding": "IMAGES" },
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "art-free-guide-staging"
				}
			],
			"r2_buckets": [
				{
					"binding": "AUDIO",
					"bucket_name": "artfreeguide-audio"
				}
			]
		},
		"production": {
			"name": "art-free-guide",
			"vars": {
				"LLM_PROVIDER": "workers-ai,nvidia",
				"LLM_GUIDE_PROVIDER": "gemini,workers-ai",
				"GEMINI_MODEL": "gemini-4-hydrogen",
				"WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/meta/llama-3.1-8b-instruct-fast",
				"LLM_GUIDE_MODEL": "nvidia/nemotron-3-super-120b-a12b,google/gemma-4-31b-it",
				"LLM_ASK_MODEL": "nvidia/nemotron-3-nano-30b-a3b",
				"LLM_SUGGEST_MODEL": "mistralai/mistral-nemotron,meta/llama-3.1-8b-instruct",
				"EMBEDDING_PROVIDER": "workers-ai",
				"GUIDE_STORE": "d1",
				"GUIDE_SYSTEM_PROMPT": ""
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "artfreeguide_db_trial",
					"database_id": "1028e2d0-e5d5-47e7-b828-bacea0c934d0",
					"migrations_dir": "d1/migrations"
				}
			],
			"ai": { "binding": "AI" },
			"images": { "binding": "IMAGES" },
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "art-free-guide"
				}
			],
			"r2_buckets": [
				{
					"binding": "AUDIO",
					"bucket_name": "artfreeguide-audio"
				}
			]
		}
	}
}
